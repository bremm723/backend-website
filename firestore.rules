rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Setiap orang cuma boleh baca-tulis dokumen progresnya sendiri.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Tutup semua path lain secara default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
